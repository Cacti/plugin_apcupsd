msgid "The physical location of the Device.  This free form text can be a room, rack location, etc."
msgstr "የመሣሪያው አካላዊ መገኛ። ይህ ነጻ ጽሑፍ ክፍል፣ የራክ ቦታ ወዘተ ሊሆን ይችላል።"

#: upses.php
msgid "Cacti Device"
msgstr "የCacti መሣሪያ"

#: upses.php
msgid "For SNMP Based UPS', select the Cacti Device to use for SNMP credentials.  Otherwise, select None, and the UPS plugin will create the Device for you automatically."
msgstr "በSNMP ላይ ለተመሠረቱ UPSዎች ለSNMP ማረጋገጫዎች የሚያገለግለውን የCacti መሣሪያ ይምረጡ። ያለበለዚያ ምንም የሚለውን ይምረጡ፣ እና የUPS ተሰኪው መሣሪያውን በራስ-ሰር ይፈጥርልዎታል።"

#: upses.php
msgid "Autocreate on First Poll"
msgstr "በመጀመሪያው Poll ላይ በራስ-ሰር ፍጠር"

#: upses.php
msgid "Enabled"
msgstr "ነቅቷል"

#: upses.php
msgid "Check to immediately start polling for data."
msgstr "ውሂብ መሰብሰብ (polling) ወዲያውኑ ለመጀመር ምልክት ያድርጉ።"

#: upses.php
msgid "APC UPSD Information"
msgstr "የAPC UPSD መረጃ"

#: upses.php
msgid "The hostname of the host running apcupsd or the NUT server (upsd)."
msgstr "apcupsd ወይም የNUT አገልጋይ (upsd) የሚያሄደው አስተናጋጅ ስም።"

#: upses.php
msgid "TCP Port"
msgstr "የTCP ወደብ"

#: upses.php
msgid "Enter the TCP Port for this UPS.  apcupsd defaults to 3551 and NUT defaults to 3493."
msgstr "ለዚህ UPS የTCP ወደብ ያስገቡ። የapcupsd ነባሪ 3551 ሲሆን የNUT ነባሪ 3493 ነው።"

#: upses.php
msgid "Timeout (seconds)"
msgstr "የጊዜ ማብቂያ (ሰከንዶች)"

#: upses.php
msgid "How long the poller waits for apcupsd or the NUT server before giving up on this UPS, from 1 to 120 seconds.  SNMP based UPS's use the SNMP timeout instead."
msgstr "pollerው ይህን UPS ከመተዉ በፊት ለapcupsd ወይም ለNUT አገልጋዩ ምን ያህል ጊዜ እንደሚጠብቅ፣ ከ1 እስከ 120 ሰከንዶች። በSNMP ላይ የተመሠረቱ UPSዎች በምትኩ የSNMP የጊዜ ማብቂያን ይጠቀማሉ።"

#: upses.php
msgid "NUT Options"
msgstr "የNUT አማራጮች"

#: upses.php
msgid "NUT UPS Name"
msgstr "የNUT UPS ስም"

#: upses.php
msgid "The name of the UPS on the NUT server, as listed by \"upsc -l\" (the part before the @ in ups@host).  One NUT server can serve several UPSes."
msgstr "በ\"upsc -l\" እንደተዘረዘረው በNUT አገልጋዩ ላይ ያለው የUPS ስም (በups@host ውስጥ ከ@ በፊት ያለው ክፍል)። አንድ የNUT አገልጋይ ለብዙ UPSዎች ማገልገል ይችላል።"

#: upses.php
msgid "NUT Username"
msgstr "የNUT የተጠቃሚ ስም"

#: upses.php
msgid "Optional.  The upsd.users account to authenticate with.  Leave blank for anonymous read-only access, which is how NUT servers are usually monitored."
msgstr "አማራጭ። ለማረጋገጫ የሚያገለግለው የupsd.users መለያ። ስም-አልባ የንባብ-ብቻ መዳረሻ ለማግኘት ባዶ ይተዉት፤ የNUT አገልጋዮች ብዙውን ጊዜ የሚከታተሉት በዚህ መንገድ ነው።"

#: upses.php
msgid "NUT Password"
msgstr "የNUT የይለፍ ቃል"

#: upses.php
msgid "The password for the NUT Username."
msgstr "ለNUT የተጠቃሚ ስም የይለፍ ቃል።"

#: upses.php
msgid "Use TLS (STARTTLS)"
msgstr "TLS (STARTTLS) ተጠቀም"

#: upses.php
msgid "Encrypt the connection with STARTTLS before any credentials are sent.  The NUT server certificate and host name are verified, so the certificate must be trusted by the Cacti poller, or you can point to its CA / certificate file below."
msgstr "ማንኛውም የማረጋገጫ መረጃ ከመላኩ በፊት ግንኙነቱን በSTARTTLS ያመስጥሩ። የNUT አገልጋዩ የምስክር ወረቀት እና የአስተናጋጅ ስም ስለሚረጋገጡ የምስክር ወረቀቱ በCacti poller መታመን አለበት፣ ወይም ከታች ወደ CA / የምስክር ወረቀት ፋይሉ መጠቆም ይችላሉ።"

#: upses.php
msgid "CA / Certificate File"
msgstr "CA / የምስክር ወረቀት ፋይል"

#: upses.php
msgid "Optional.  The full path on the Cacti poller to a PEM file holding the CA certificate (or the self-signed server certificate) to verify the NUT server against, for example /etc/nut/upsd.pem.  The host name above must match the certificate."
msgstr "አማራጭ። የNUT አገልጋዩን ለማረጋገጥ የCA የምስክር ወረቀቱን (ወይም በራስ-የተፈረመውን የአገልጋይ የምስክር ወረቀት) የያዘው የPEM ፋይል በCacti poller ላይ ያለው ሙሉ መንገድ፣ ለምሳሌ /etc/nut/upsd.pem። ከላይ ያለው የአስተናጋጅ ስም ከምስክር ወረቀቱ ጋር መዛመድ አለበት።"

#: upses.php
msgid "Allow Self-Signed Certificate"
msgstr "በራስ-የተፈረመ የምስክር ወረቀት ፍቀድ"

#: upses.php
msgid "Accept any certificate without checking it.  The connection is still encrypted, but the NUT server is not authenticated, so a man-in-the-middle could read the NUT credentials.  Prefer the CA / Certificate File above."
msgstr "ማንኛውንም የምስክር ወረቀት ሳይፈትሹ ይቀበሉ። ግንኙነቱ አሁንም የተመሰጠረ ነው፣ ነገር ግን የNUT አገልጋዩ አልተረጋገጠም፣ ስለዚህ መሃል-ገብ አጥቂ የNUT ማረጋገጫዎችን ሊያነብ ይችላል። ከላይ ያለውን CA / የምስክር ወረቀት ፋይል ይምረጡ።"

#: upses.php
msgid "SNMP Options"
msgstr "የSNMP አማራጮች"

#: upses.php
msgid "The hostname where the snmp agent is located."
msgstr "የsnmp ወኪል የሚገኝበት የአስተናጋጅ ስም።"

#: upses.php
msgid "The Poller ID cannot be changed while the UPS is linked to a Cacti Device.  Change the poller on the device instead."
msgstr "UPSው ከCacti መሣሪያ ጋር ተገናኝቶ እያለ የPoller መለያው ሊቀየር አይችልም። በምትኩ በመሣሪያው ላይ ያለውን poller ይቀይሩ።"

#: upses.php
msgid "Template UPS was not found! Unable to duplicate."
msgstr "አብነት UPS አልተገኘም! ማባዛት አልተቻለም።"

#: upses.php
msgid "None of the selected UPSes has a Cacti Device yet, so Graph Automation was not run.  A device is created on the first successful poll."
msgstr "ከተመረጡት UPSዎች ውስጥ አንዱም ገና የCacti መሣሪያ የለውም፣ ስለዚህ የግራፍ አውቶሜሽን አልተሄደም። መሣሪያ የሚፈጠረው በመጀመሪያው የተሳካ poll ላይ ነው።"

#: upses.php
#, php-format
msgid "Graph Automation was run for %d UPS(es).  %d UPS(es) have no Cacti Device yet and were skipped."
msgstr "የግራፍ አውቶሜሽን ለ%d UPS(ዎች) ተሂዷል። %d UPS(ዎች) ገና የCacti መሣሪያ ስለሌላቸው ታልፈዋል።"

#: upses.php
#, php-format
msgid "Graph Automation was run for %d UPS(es)."
msgstr "የግራፍ አውቶሜሽን ለ%d UPS(ዎች) ተሂዷል።"

#: upses.php
msgid "(no Cacti Device yet)"
msgstr "(ገና የCacti መሣሪያ የለም)"

#: upses.php
msgid "Click 'Continue' to Delete the following UPS.  Note, all Devices will be disassociated from this UPS."
msgid_plural "Click 'Continue' to Delete all following UPSes.  Note, all devices will be disassociated from this UPS."
msgstr[0] "የሚከተለውን UPS ለመሰረዝ 'ቀጥል' የሚለውን ጠቅ ያድርጉ።  ማስታወሻ፣ ሁሉም መሣሪያዎች ከዚህ UPS ጋር ያላቸው ግንኙነት ይቋረጣል።"
msgstr[1] "የሚከተሉትን ሁሉንም UPSዎች ለመሰረዝ 'ቀጥል' የሚለውን ጠቅ ያድርጉ።  ማስታወሻ፣ ሁሉም መሣሪያዎች ከዚህ UPS ጋር ያላቸው ግንኙነት ይቋረጣል።"

