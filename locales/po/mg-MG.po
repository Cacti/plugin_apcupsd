#: upses.php
msgid "Click 'Continue' to Reset Discovery the following UPS.  Note, this only applies for SNMPD type UPSes."
msgid_plural "Click 'Continue' to Reset Discovery for the following UPSes.  Note, this only applies for SNMPD type UPSes."
msgstr[0] "Tsindrio ny 'Tohizo' mba hamerenana amin'ny laoniny ny Fikarohana ho an'ity UPS manaraka ity. Marihina fa ho an'ireo UPS karazana SNMPD ihany no mihatra izany."
msgstr[1] "Tsindrio ny 'Tohizo' mba hamerenana amin'ny laoniny ny Fikarohana ho an'ireto UPS manaraka ireto. Marihina fa ho an'ireo UPS karazana SNMPD ihany no mihatra izany."

#: upses.php
msgid "Reset UPS"
msgid_plural "Reset UPSes"
msgstr[0] "Avereno amin'ny laoniny ny UPS"
msgstr[1] "Avereno amin'ny laoniny ireo UPS"

#: upses.php
msgid "Click 'Continue' to run Graph Automation for the following UPS.  Graphs, data sources and tree items are created from the device's templates and the matching automation rules; graphs that already exist are left as they are.  Only a UPS that already has a Cacti Device is affected."
msgid_plural "Click 'Continue' to run Graph Automation for the following UPSes.  Graphs, data sources and tree items are created from each device's templates and the matching automation rules; graphs that already exist are left as they are.  Only a UPS that already has a Cacti Device is affected."
msgstr[0] "Tsindrio ny 'Tohizo' mba hampandehanana ny Fanaovana kisary ho azy ho an'ity UPS manaraka ity. Ny kisary, ny loharanon-drakitra ary ny singa ao amin'ny hazo dia foronina avy amin'ny môdelin'ilay fitaovana sy ny fitsipika fanaovana ho azy mifanaraka amin'izany; avela amin'izao kosa ireo kisary efa misy. Ny UPS efa manana Fitaovana Cacti ihany no voakasika."
msgstr[1] "Tsindrio ny 'Tohizo' mba hampandehanana ny Fanaovana kisary ho azy ho an'ireto UPS manaraka ireto. Ny kisary, ny loharanon-drakitra ary ny singa ao amin'ny hazo dia foronina avy amin'ny môdelin'ny fitaovana tsirairay sy ny fitsipika fanaovana ho azy mifanaraka amin'izany; avela amin'izao kosa ireo kisary efa misy. Ny UPS efa manana Fitaovana Cacti ihany no voakasika."

#: upses.php
msgid "Click 'Continue' to Enable the following UPS."
msgid_plural "Click 'Continue' to Enable all following UPSes."
msgstr[0] "Tsindrio ny 'Tohizo' mba handefasana ity UPS manaraka ity."
msgstr[1] "Tsindrio ny 'Tohizo' mba handefasana ireo UPS manaraka rehetra."

